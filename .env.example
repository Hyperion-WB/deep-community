# 数据库配置
# 首次部署强烈建议把下面的数据库口令改成随机值，并同步修改 DATABASE_URL 中的密码
DATABASE_URL=postgresql+asyncpg://app_user:change_me_strong_password@db:5432/community_db
POSTGRES_DB=community_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me_strong_password

# Redis 配置
REDIS_URL=redis://redis:6379/0

# 安全密钥 (生产环境请务必替换为 64 位随机字符)
# 必填：openssl rand -hex 32；留空时生产环境会拒绝启动，开发环境会生成临时密钥
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 上传目录与大小限制（静态图与动图分开限制，GIF 不转码因此可放宽）
UPLOAD_DIR=/app/uploads
MAX_IMAGE_SIZE_MB=5
MAX_GIF_SIZE_MB=20

# 运行端口与环境
PORT=8000
# 宿主机对外端口（compose 端口映射）；直接对外用 80，前面有宿主 nginx 时改成 9119 等
WEB_PORT=80
ENVIRONMENT=production

# 文件存储：当前只落本地磁盘，对象存储默认停用（代码与后台诊断接口全部保留）
# 重新启用对象存储时：填好下面 6 个 S3_* 配置，并把 S3_ENABLED 改成 1
STORAGE_TYPE=local
S3_ENABLED=0
# 以下为可选对象存储配置，未启用时保持注释即可
# S3_ENDPOINT=https://<your_account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=your_r2_access_key_id
# S3_SECRET_KEY=your_r2_secret_access_key
# S3_BUCKET=community-images
# S3_PUBLIC_DOMAIN=https://img.yourdomain.com
# 只有 Cloudflare R2 填 auto；阿里云 OSS / 腾讯 COS / MinIO 等必须填真实 region
# S3_REGION=auto
# 本地模式下的镜像双写（本地为主 + 对象存储备份），需要同时开启 S3_ENABLED
# S3_MIRROR=0

# 首次部署的超级管理员初始口令（首次登录会被强制要求修改；可在部署前覆盖）
# 初始超管口令：留空则首次启动随机生成并打印到日志（首次登录强制改密）
BOOTSTRAP_ADMIN_PASSWORD=

# 跨域白名单（同源部署留空即可；前后端分域时用逗号分隔，如 https://a.com,https://b.com）
CORS_ORIGINS=

# 是否开放 /api/docs 交互文档（生产默认关闭，需要时置 1）
ENABLE_API_DOCS=0

# 后端 worker 数（默认 2；内存紧张可回退为 1）
UVICORN_WORKERS=2

# ===== 第三方登录 =====
# GitHub OAuth（留空则隐藏 GitHub 登录按钮）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Gitee OAuth（在 https://gitee.com/oauth/applications 创建应用后填写）
# 回调地址固定为：https://你的域名/api/auth/gitee/callback
GITEE_CLIENT_ID=
GITEE_CLIENT_SECRET=
# 站点对外地址（用于 OAuth 回调与邮件中的链接；反代场景建议显式配置）
PUBLIC_SITE_URL=https://your-domain.com

# ===== 邮箱服务（注册验证码 / 找回密码）=====
# 465 端口用 SSL：SMTP_USE_SSL=1；587 端口用 STARTTLS：SMTP_USE_SSL=0 且 SMTP_USE_STARTTLS=1
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=极客社区 <no-reply@example.com>
SMTP_USE_SSL=1
SMTP_USE_STARTTLS=0
# 验证码有效期（秒）、重发冷却（秒）、单码最大错误次数
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
# 注册是否强制邮箱验证（SMTP 未配置时会自动降级放行，避免锁死注册）
EMAIL_VERIFICATION_REQUIRED=1
# 仅内网自测：未配置 SMTP 时把验证码直接返回给前端，生产务必为 0
EMAIL_DEV_EXPOSE_CODE=0

# ===== Cloudflare Turnstile 人机校验（Site Key / Secret Key 任一为空则关闭）=====
# 用途：注册、密码连续错误后的登录、频繁发送邮箱验证码
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 同一账号密码错误达到 N 次后，登录需要人机校验
CAPTCHA_LOGIN_AFTER_FAILURES=3
# 同一 IP 每小时发送 N 封验证码后，发信需要人机校验
CAPTCHA_EMAIL_AFTER_SENDS=5
